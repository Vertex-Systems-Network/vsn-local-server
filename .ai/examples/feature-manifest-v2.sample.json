    "approved_at": "2026-08-28"
  },
  "approval": {
    "scope": "FEATURE",
    "allowed_scopes": ["TASK", "WORK_PACKAGE", "FEATURE", "PROJECT", "RELEASE", "PRIVILEGED_ACTION"],
    "approval_ref": "example:human-approval",
