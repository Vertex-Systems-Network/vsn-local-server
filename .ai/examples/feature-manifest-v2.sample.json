    "abuse_cases": ["untrusted input attempts to widen scope"],
    "forbidden_boundaries": ["product runtime outside example module"]
  },
  "preflight": {
    "expected_changes": {
      "paths": ["src/example/**", "tests/example/**"],
      "modules": ["example-module"],
      "change_types": ["implementation", "tests"]
    },
    "shared_surfaces": [
      {
        "surface": "src/shared/config.ts",
        "owners": ["example-module"],
        "collision_key": "shared-config"
      }
    ],
    "scope_budget": {
      "max_changed_files": 8,
      "max_new_files": 4,
      "max_shared_surfaces": 1,
      "notes": "exceeding any bound requires reassessment"
    },
    "scope_exceeded_action": "STOP_AND_REASSESS"
  },
  "parallel_safety": {
    "classification": "SERIALIZE_SHARED_SURFACE",
    "allowed_classifications": ["PARALLEL_SAFE", "SERIALIZE_SHARED_SURFACE", "EXCLUSIVE"],
    "collision_keys": ["shared-config"],
    "on_collision": "STOP_AND_REASSESS"
  },
  "stages": {
