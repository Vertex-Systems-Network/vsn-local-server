<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="VSN Dev Platform Runtime" Manufacturer="VSN" Version="$(var.ProductVersion)" UpgradeCode="7D7C6A8F-6CF4-4D83-9D9F-DF44D8B8D5B4" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer VSN runtime is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="VSN">
        <Component Id="AgentComponent" Guid="*">
          <File Id="AgentExe" Source="$(var.SourceDir)\vsn-agent.exe" KeyPath="yes" />
          <ServiceInstall Id="AgentService" Name="VSNAgent" DisplayName="VSN Agent" Description="VSN machine-local secure execution agent" Type="ownProcess" Start="auto" ErrorControl="normal" Arguments="--service-run" Account="NT AUTHORITY\LocalService" />
          <ServiceControl Id="AgentServiceControl" Name="VSNAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
        <Component Id="CliComponent" Guid="*">
          <File Id="CliExe" Source="$(var.SourceDir)\vsn.exe" KeyPath="yes" />
          <Environment Id="VsnPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" />
        </Component>
        <Component Id="UpdaterComponent" Guid="*"><File Id="UpdaterExe" Source="$(var.SourceDir)\vsn-updater-helper.exe" KeyPath="yes" /></Component>
        <Component Id="ExtensionSandboxComponent" Guid="*"><File Id="ExtensionSandboxExe" Source="$(var.SourceDir)\vsn-extension-appcontainer.exe" KeyPath="yes" /></Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="RuntimeFeature" Title="VSN Runtime" Level="1">
      <ComponentRef Id="AgentComponent" />
      <ComponentRef Id="CliComponent" />
      <ComponentRef Id="UpdaterComponent" />
    </Feature>
  </Package>
</Wix>
