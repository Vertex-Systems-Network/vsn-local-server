VSN_DOMAIN=control.example.com
VSN_CONTROL_ADMIN_TOKEN=replace-with-a-long-random-token
VSN_CONTROL_PRIVATE_KEY_B64=replace-with-output-private_key-from-key-generator
VSN_CONTROL_AUTH_KEY_B64=replace-with-32-byte-base64-auth-encryption-key
VSN_CONTROL_VAULT_KEY_B64=replace-with-separate-32-byte-base64-team-vault-key
# Optional multi-key Team Vault keyring JSON: {"key-2026-01":"<base64-32-byte>","key-2026-02":"<base64-32-byte>"}
VSN_CONTROL_VAULT_KEYRING_JSON=
# Optional active key id. Defaults to first loaded key or legacy when only VSN_CONTROL_VAULT_KEY_B64 is used.
VSN_CONTROL_VAULT_ACTIVE_KEY_ID=
VSN_CONTROL_INSTANCE_ID=control-01
VSN_CONTROL_PUBLIC_ENDPOINT=https://control.example.com
VSN_WEBAUTHN_RP_ID=control.example.com
VSN_WEBAUTHN_ORIGIN=https://control.example.com
# Optional shared PostgreSQL snapshot store. Leave blank for local SQLite.
VSN_CONTROL_POSTGRES_DSN=
VSN_CONTROL_POSTGRES_CA_PEM=
VSN_CONTROL_POSTGRES_IMPORT_LOCAL=0

# Example confidential OIDC client secret. Reference its variable name from client_secret_env in the OIDC provider policy.
VSN_OIDC_CORP_CLIENT_SECRET=
