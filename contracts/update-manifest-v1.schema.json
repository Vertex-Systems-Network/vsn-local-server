{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsn.dev/contracts/update-manifest-v1.schema.json",
  "title": "VSN Signed Update Manifest",
  "type": "object",
  "required": [
    "version",
    "product",
    "release",
    "channel",
    "published_at_unix_ms",
    "artifacts",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "product": {
      "const": "vsn-platform"
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "enum": [
        "stable",
        "beta",
        "nightly"
      ]
    },
    "published_at_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "signature": {
      "type": "string",
      "minLength": 40
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "os",
          "arch",
          "url",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false,
        "properties": {
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
