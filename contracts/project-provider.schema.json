{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vsn.dev/contracts/project-provider.schema.json",
  "title":"VSN Project Provider Manifest",
  "type":"object",
  "required":["id","kind","name","markers","capabilities"],
  "additionalProperties":false,
  "properties":{
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "kind":{"const":"project"},
    "name":{"type":"string","minLength":1},
    "markers":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "capabilities":{"type":"array","uniqueItems":true,"items":{"enum":["detect","bootstrap","dependencies","environment","health"]}},
    "permissions":{"type":"array","uniqueItems":true,"items":{"enum":["process","filesystem","network","secrets"]}}
  }
}
