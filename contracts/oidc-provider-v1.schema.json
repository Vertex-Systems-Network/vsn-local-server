{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsn.dev/contracts/oidc-provider-v1.schema.json",
  "title": "VSN OIDC Provider v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{2,96}$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^https://"
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "redirect_url": {
      "type": "string",
      "minLength": 8,
      "maxLength": 2048
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      }
    },
    "pkce_required": {
      "const": true
    },
    "authorization_endpoint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://",
      "maxLength": 2048
    },
    "client_secret_env": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z0-9_]{3,128}$"
    },
    "mfa_assured": {
      "type": "boolean"
    },
    "end_session_endpoint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://",
      "maxLength": 2048
    },
    "post_logout_redirect_url": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 8,
      "maxLength": 2048
    }
  },
  "required": [
    "id",
    "issuer",
    "client_id",
    "redirect_url",
    "scopes",
    "pkce_required"
  ]
}
