{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsn.dev/contracts/environment-topology-v1.schema.json",
  "title": "VSN Environment Topology",
  "type": "object",
  "required": [
    "id",
    "name",
    "bindings"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{2,96}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "bindings": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9._-]{2,96}$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "labels": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      }
    }
  }
}
