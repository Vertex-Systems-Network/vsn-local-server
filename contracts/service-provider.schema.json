{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsn.dev/contracts/service-provider.schema.json",
  "title": "VSN Service Provider Manifest",
  "type": "object",
  "required": ["id", "kind", "name", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "kind": {"const": "service"},
    "name": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["install", "start", "stop", "restart", "health", "logs", "config", "ports"]}
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["process", "filesystem", "network", "admin"]}
    }
  }
}
