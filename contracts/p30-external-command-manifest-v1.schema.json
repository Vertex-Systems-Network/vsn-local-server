{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vsn.dev/contracts/p30-external-command-manifest-v1.schema.json",
  "title":"VSN P30 External Command Manifest v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","product_version","candidate_id","commands"],
  "properties":{
    "schema_version":{"const":1},
    "product_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "candidate_id":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "commands":{"type":"object","additionalProperties":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"string","minLength":1,"maxLength":4096}}}
  }
}
