    {"type":"object","additionalProperties":false,"required":["operation","install_root"],"properties":{"operation":{"const":"status"},"install_root":{"type":"string","minLength":1,"maxLength":4096}}},
    {"type":"object","additionalProperties":false,"required":["operation","install_root","confirm_recover"],"properties":{"operation":{"const":"recover_lock"},"install_root":{"type":"string","minLength":1,"maxLength":4096},"confirm_recover":{"const":true}}}
  ]
