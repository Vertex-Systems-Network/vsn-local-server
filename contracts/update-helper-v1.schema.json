{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vsn.local/contracts/update-helper-v1.schema.json",
  "title":"VSN Out-of-Process Updater Helper v1",
  "oneOf":[
    {"type":"object","additionalProperties":false,"required":["operation","request"],"properties":{"operation":{"const":"apply"},"request":{"$ref":"update-file-apply-v1.schema.json"}}},
