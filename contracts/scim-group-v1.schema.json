{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vsn.dev/contracts/scim-group-v1.schema.json",
  "title":"VSN SCIM 2.0 Group Input",
  "type":"object",
  "additionalProperties":true,
  "required":["displayName"],
  "properties":{
    "schemas":{"type":"array","maxItems":16,"items":{"type":"string","maxLength":256}},
    "displayName":{"type":"string","minLength":1,"maxLength":256},
    "externalId":{"type":["string","null"],"maxLength":256},
    "members":{"type":"array","maxItems":10000,"items":{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":2,"maxLength":96}},"additionalProperties":true}}
  }
}
