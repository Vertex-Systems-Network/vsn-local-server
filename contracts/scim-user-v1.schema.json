{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vsn.local/contracts/scim-user-v1.schema.json",
  "title":"VSN SCIM 2.0 User Provisioning Input",
  "type":"object",
  "additionalProperties":true,
  "required":["userName"],
  "properties":{
    "schemas":{"type":"array","maxItems":16,"items":{"type":"string","maxLength":256}},
    "userName":{"type":"string","minLength":3,"maxLength":320},
    "externalId":{"type":["string","null"],"maxLength":256},
    "active":{"type":"boolean"},
    "roles":{"type":"array","maxItems":1,"items":{"type":"object","required":["value"],"properties":{"value":{"type":"string","minLength":2,"maxLength":96}},"additionalProperties":true}}
  }
}
