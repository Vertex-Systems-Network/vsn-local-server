{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsn.dev/contracts/extension-manifest.schema.json",
  "title": "VSN Extension Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "api_version",
    "providers",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "api_version": {
      "type": "integer",
      "minimum": 1
    },
    "providers": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "manifest"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "runtime",
              "database",
              "service",
              "project",
              "container",
              "cloud",
              "os",
              "network"
            ]
          },
          "manifest": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "network",
          "filesystem.read",
          "filesystem.write",
          "process.execute",
          "secrets.use",
          "database.connect"
        ]
      }
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "executables": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,128}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "fixed_args": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "properties": {
        "providers": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "executables"
      ],
      "properties": {
        "executables": {
          "minItems": 1
        }
      }
    }
  ]
}
