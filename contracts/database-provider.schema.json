{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsn.dev/contracts/database-provider.schema.json",
  "title": "VSN Database Provider Manifest",
  "type": "object",
  "required": ["id", "kind", "name", "model", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "kind": {"const": "database"},
    "name": {"type": "string", "minLength": 1},
    "model": {
      "enum": ["relational", "document", "key_value", "graph", "search", "time_series", "column", "vector", "custom"]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "connect", "introspect", "query", "browse", "insert", "update", "delete",
          "schemas", "entities", "indexes", "relations", "functions", "users", "permissions",
          "import", "export", "backup", "restore", "statistics"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["process", "filesystem", "network", "secrets", "admin"]}
    }
  }
}
