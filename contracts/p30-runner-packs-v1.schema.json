{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsn.dev/contracts/p30-runner-packs-v1.schema.json",
  "title": "VSN P30 Runner Packs v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_version",
    "packs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "product_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "controls",
          "required_tools",
          "optional_tools",
          "workflow",
          "description",
          "execution_mode"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "platform": {
            "enum": [
              "linux",
              "windows",
              "macos",
              "cross-platform"
            ]
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "required_tools": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "optional_tools": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "execution_mode": {
            "enum": [
              "ci",
              "live-environment",
              "reviewer"
            ]
          }
        }
      }
    }
  }
}
