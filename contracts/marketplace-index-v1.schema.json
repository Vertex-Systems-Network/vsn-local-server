{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vsn.dev/contracts/marketplace-index-v1.schema.json",
  "type": "object",
  "required": [
    "api_version",
    "generated_at_unix_ms",
    "entries"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "generated_at_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "version",
          "publisher",
          "package_url",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "package_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "provider_kinds": {
            "type": "array",
            "items": {
              "enum": [
                "runtime",
                "database",
                "service",
                "project",
                "container",
                "cloud",
                "os",
                "network"
              ]
            }
          },
          "summary": {
            "type": "string"
          },
          "channels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,32}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "signature": {
      "type": [
        "string",
        "null"
      ]
    },
    "revocations": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "reason",
          "revoked_at_unix_ms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "revoked_at_unix_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "additionalProperties": false
}
