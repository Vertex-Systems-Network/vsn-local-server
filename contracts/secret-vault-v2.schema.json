{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vsn.dev/contracts/secret-vault-v2.schema.json",
  "title":"VSN Vault File v2",
  "description":"Encrypted local vault using an OS-secure-store key identifier so master keys can rotate without placing key material in the file.",
  "type":"object","additionalProperties":false,"required":["version","key_id","entries"],
  "properties":{
    "version":{"const":2},"key_id":{"type":"string","minLength":8,"maxLength":128,"pattern":"^[A-Za-z0-9._-]+$"},
    "entries":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["name","nonce","ciphertext","updated_at_unix"],"properties":{"name":{"type":"string","minLength":1,"maxLength":128},"nonce":{"type":"string"},"ciphertext":{"type":"string"},"updated_at_unix":{"type":"integer","minimum":0}}}}
  }
}
