{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vsn.local/contracts/release-certification-evidence-v1.schema.json",
  "title":"VSN Release Certification Evidence v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","product_version","updated_at","checks"],
  "properties":{
    "schema_version":{"const":1},"product_version":{"type":"string","minLength":1,"maxLength":64},"updated_at":{"type":"string","minLength":10,"maxLength":80},
    "checks":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"object","additionalProperties":true,"required":["id","status"],"properties":{"id":{"type":"string","minLength":2,"maxLength":96},"status":{"enum":["pending","pass","fail","waived"]},"platform":{"type":"string","maxLength":64},"evidence":{"type":["string","null"],"maxLength":4096},"artifact_sha256":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"notes":{"type":"string","maxLength":4096}}}}
  }
}
